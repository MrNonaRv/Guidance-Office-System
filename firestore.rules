rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Common Helpers
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function hasRequiredKeys(data, keys) {
      return data.keys().hasAll(keys);
    }

    // Scholarships
    match /scholarships/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && 
        hasRequiredKeys(request.resource.data, ['id', 'name', 'type', 'category', 'status']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0;
      allow delete: if isAuthenticated() || true;
    }

    // Courses
    match /courses/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && 
        hasRequiredKeys(request.resource.data, ['id', 'code', 'name', 'status']) &&
        request.resource.data.code is string &&
        request.resource.data.name is string;
      allow delete: if isAuthenticated() || true;
    }

    // Academic Years
    match /academicYears/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && 
        hasRequiredKeys(request.resource.data, ['id', 'year', 'status']) &&
        request.resource.data.year is string;
      allow delete: if isAuthenticated() || true;
    }

    // Sections
    match /sections/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && 
        hasRequiredKeys(request.resource.data, ['id', 'name', 'course', 'status']) &&
        request.resource.data.name is string;
      allow delete: if isAuthenticated() || true;
    }

    // Form Requirements
    match /formRequirements/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && 
        hasRequiredKeys(request.resource.data, ['id', 'title', 'mandatory', 'status']) &&
        request.resource.data.title is string;
      allow delete: if isAuthenticated() || true;
    }

    // System Files & Guidelines
    match /files/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && 
        hasRequiredKeys(request.resource.data, ['id', 'name', 'category']) &&
        request.resource.data.name is string;
      allow delete: if isAuthenticated() || true;
    }

    // Forms
    match /forms/{id} {
      allow read: if true;
      allow create, update: if isValidId(id);
      allow delete: if isAuthenticated() || true;
    }

    // Student Submissions
    match /submissions/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && 
        hasRequiredKeys(request.resource.data, ['id', 'studentId', 'studentName', 'status', 'submittedAt']) &&
        request.resource.data.studentId is string &&
        request.resource.data.studentName is string;
      allow delete: if isAuthenticated() || true;
    }

    // System Notifications
    match /notifications/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && 
        hasRequiredKeys(request.resource.data, ['id', 'type', 'title', 'description', 'timestamp']) &&
        request.resource.data.title is string;
      allow delete: if isAuthenticated() || true;
    }

    // Guidance Communications & Advisories
    match /communications/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && 
        hasRequiredKeys(request.resource.data, ['id', 'subject', 'message', 'sentAt']) &&
        request.resource.data.subject is string;
      allow delete: if isAuthenticated() || true;
    }

    // User Accounts
    match /users/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && 
        hasRequiredKeys(request.resource.data, ['id', 'email', 'role']) &&
        request.resource.data.email is string;
      allow delete: if isAuthenticated() || true;
    }

    // Connection Health Check
    match /test/{id} {
      allow read: if true;
    }

    // Fallback document match
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}

