rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /scholarships/{document=**} {
      allow read, write: if true;
    }
    match /submissions/{document=**} {
      allow read, write: if true;
    }
    match /notifications/{document=**} {
      allow read, write: if true;
    }
  }
}
