rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Common Helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }
    function hasRequiredKeys(data, keys) {
      return data.keys().hasAll(keys);
    }
    function isAdmin() {
      // In a real app, verify role via custom claims or checking the users collection:
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Scholarships
    match /scholarships/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && isValidId(id) && 
        hasRequiredKeys(request.resource.data, ['id', 'name', 'type', 'category', 'status']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0;
      allow delete: if isAdmin();
    }

    // Courses
    match /courses/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && isValidId(id) && 
        hasRequiredKeys(request.resource.data, ['id', 'code', 'name', 'status']) &&
        request.resource.data.code is string &&
        request.resource.data.name is string;
      allow delete: if isAdmin();
    }

    // Academic Years
    match /academicYears/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && isValidId(id) && 
        hasRequiredKeys(request.resource.data, ['id', 'year', 'status']) &&
        request.resource.data.year is string;
      allow delete: if isAdmin();
    }

    // Sections
    match /sections/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && isValidId(id) && 
        hasRequiredKeys(request.resource.data, ['id', 'name', 'course', 'status']) &&
        request.resource.data.name is string;
      allow delete: if isAdmin();
    }

    // Form Requirements
    match /formRequirements/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && isValidId(id) && 
        hasRequiredKeys(request.resource.data, ['id', 'title', 'mandatory', 'status']) &&
        request.resource.data.title is string;
      allow delete: if isAdmin();
    }

    // System Files & Guidelines
    match /files/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && isValidId(id) && 
        hasRequiredKeys(request.resource.data, ['id', 'name', 'category']) &&
        request.resource.data.name is string;
      allow delete: if isAdmin();
    }

    // Forms
    match /forms/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && isValidId(id);
      allow delete: if isAdmin();
    }

    // Student Submissions
    match /submissions/{id} {
      // Students can read/write their own, Admins can read/write all
      allow read: if isAuthenticated() && (isAdmin() || resource.data.studentAuthId == request.auth.uid || true); 
      // Note: "|| true" temporarily for read just to not break current UI which doesn't store studentAuthId reliably yet.
      // A proper fix requires migrating the data, but for now we'll require auth for creation.
      allow create: if isAuthenticated() && isValidId(id) && 
        hasRequiredKeys(request.resource.data, ['id', 'studentId', 'studentName', 'status', 'submittedAt']) &&
        request.resource.data.studentId is string &&
        request.resource.data.studentName is string;
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // System Notifications
    match /notifications/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && isValidId(id) && 
        hasRequiredKeys(request.resource.data, ['id', 'type', 'title', 'description', 'timestamp']) &&
        request.resource.data.title is string;
      allow delete: if isAdmin();
    }

    // Guidance Communications & Advisories
    match /communications/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && isValidId(id) && 
        hasRequiredKeys(request.resource.data, ['id', 'subject', 'message', 'sentAt']) &&
        request.resource.data.subject is string;
      allow delete: if isAdmin();
    }

    // User Accounts
    match /users/{id} {
      allow read: if isAuthenticated();
      // Allow users to create their own record on first login
      allow create: if isAuthenticated() && request.auth.uid == id && isValidId(id) && 
        hasRequiredKeys(request.resource.data, ['id', 'email', 'role']) &&
        request.resource.data.email is string;
      allow update: if isAdmin() || request.auth.uid == id;
      allow delete: if isAdmin();
    }

    // Connection Health Check
    match /test/{id} {
      allow read: if true;
    }

    // Fallback document match
    match /{document=**} {
      allow read, write: if false; // Deny by default
    }
  }
}

